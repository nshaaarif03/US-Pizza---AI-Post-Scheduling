APP_NAME="US Pizza AI Planner"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-PROJECT.vercel.app

# --- SESSION ---
# Vercel is stateless — use cookies instead of DB sessions.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- CACHE ---
# Use array (in-memory, per-request) since there is no persistent cache layer.
CACHE_STORE=array

# --- QUEUE ---
# Disable background queues; all jobs run synchronously.
QUEUE_CONNECTION=sync

# --- DATABASE (MySQL) ---
# Point these at your remote MySQL host (Railway, PlanetScale, etc.)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=ai_social_media_planner
DB_USERNAME=
DB_PASSWORD=

# --- GEMINI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
